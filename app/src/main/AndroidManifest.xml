<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机补播一次配置（Gboard 的接收器要等它的进程起来才存在，所以还要靠重试链） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        声明一个**运行期**权限，只为让 ZUI 的「权限」入口可点：
        ZUI 把「自启动」这一项挂在应用信息页的「权限」下面，而"未请求任何权限"时那个入口
        整行是灰的（进不去 ⇒ 也就改不了自启动）。我们不会调用它、也不会弹通知授权弹窗
        （那要显式 requestPermissions），所以实际影响为零。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 离线模型下载：前台服务（dataSync）+ 联网 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        配置广播的来源校验（见 SenderCheck）：接收器注册在 Gboard 进程里且必须 EXPORTED，
        等于把这个 action 公开出去；靠一个**签名级权限**把它收回来 ——
        只有与本模块同签名的 App 才能投递配置广播。
        权限由自己定义、自己使用（signature 级会自动授予同签名应用，无需运行时申请）。
    -->
    <permission
        android:name="moe.lovefirefly.bzk.gboardext.permission.CONFIG"
        android:protectionLevel="signature" />
    <uses-permission android:name="moe.lovefirefly.bzk.gboardext.permission.CONFIG" />


    <!--
        顺序轮转排序页要读 Gboard 的"已启用 subtype"列表 ⇒ 需要包可见性。
        （注意：ZUI 会把 <queries> 在应用信息页标成一条"读取应用列表"——我们没有声明权限，
        那只是它按可见性声明合成的标签；用户已确认不管它。）
    -->
    <queries>
        <package android:name="com.google.android.inputmethod.latin" />
        <!-- 严格模式要检测 BZK 在不在：不声明这条，getPackageInfo 会被包可见性挡住，
             结果误报"未检测到"（与搜狗组件同一处理） -->
        <package android:name="moe.lovefirefly.betterzuikey" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GboardExt"
        android:description="@string/module_desc"
        android:allowBackup="false">

        <receiver
            android:name=".ConfigRetryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_desc" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 语音引擎：配置列表页 / 添加配置页（P1） -->
        <activity
            android:name=".VoiceEngineActivity"
            android:exported="false"
            android:label="自定义语音转文字" />
        <activity
            android:name=".VoiceEngineAddActivity"
            android:exported="false"
            android:label="添加配置文件" />

        <!-- 模块通过它读 App 的配置（不依赖 XposedService，见 ConfigProvider 注释） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="moe.lovefirefly.bzk.gboardext.config"
            android:exported="true" />

        <!-- 离线模型下载（前台服务 + 通知栏进度，见 ModelDownloadService） -->
        <service
            android:name=".ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
