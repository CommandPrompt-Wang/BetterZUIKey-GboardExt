<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机补播一次配置（Gboard 的接收器要等它的进程起来才存在，所以还要靠重试链） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="moe.lovefirefly.betterzuikey" />
        <!-- 配置靠显式广播发给 Gboard，所以要能"看见"它（可见性只限制发起方） -->
        <package android:name="com.google.android.inputmethod.latin" />
        <!-- 自启动权限条目要能拉起 ZUI 安全中心的页面（并读它的状态） -->
        <package android:name="com.zui.safecenter" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GboardExt"
        android:description="@string/module_desc"
        android:allowBackup="false">

        <receiver
            android:name=".ConfigRetryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_desc" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模块通过它读 App 的配置（不依赖 XposedService，见 ConfigProvider 注释） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="moe.lovefirefly.bzk.gboardext.config"
            android:exported="true" />

    </application>

</manifest>
