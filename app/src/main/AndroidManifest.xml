<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机补播一次配置（Gboard 的接收器要等它的进程起来才存在，所以还要靠重试链） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        声明一个**运行期**权限，只为让 ZUI 的「权限」入口可点：
        ZUI 把「自启动」这一项挂在应用信息页的「权限」下面，而"未请求任何权限"时那个入口
        整行是灰的（进不去 ⇒ 也就改不了自启动）。我们不会调用它、也不会弹通知授权弹窗
        （那要显式 requestPermissions），所以实际影响为零。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <!--
        顺序轮转排序页要读 Gboard 的"已启用 subtype"列表 ⇒ 需要包可见性。
        （注意：ZUI 会把 <queries> 在应用信息页标成一条"读取应用列表"——我们没有声明权限，
        那只是它按可见性声明合成的标签；用户已确认不管它。）
    -->
    <queries>
        <package android:name="com.google.android.inputmethod.latin" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GboardExt"
        android:description="@string/module_desc"
        android:allowBackup="false">

        <receiver
            android:name=".ConfigRetryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_desc" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <activity
            android:name=".RotationActivity"
            android:exported="false"
            android:label="顺序轮转" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模块通过它读 App 的配置（不依赖 XposedService，见 ConfigProvider 注释） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="moe.lovefirefly.bzk.gboardext.config"
            android:exported="true" />

    </application>

</manifest>
