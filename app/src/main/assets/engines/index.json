{
  "version": 1,
  "_comment": "内置语音引擎清单。设置页据此播种内置配置（profile）；id 必须与脚本里的 engine.id 一致。hosts 是脚本允许连的域名白名单（P2 起由宿主强制）。",
  "engines": [
    {
      "id": "builtin-mock",
      "label": "测试",
      "script": "mock.js",
      "hosts": [],
      "config": []
    },
    {
      "id": "builtin-xunfei",
      "label": "讯飞语音听写",
      "script": "iflytek.js",
      "hosts": [
        "iat-api.xfyun.cn",
        "ws-api.xfyun.cn"
      ],
      "config": [
        {
          "key": "appid",
          "label": "APPID"
        },
        {
          "key": "apiSecret",
          "label": "APISecret",
          "secret": true
        },
        {
          "key": "apiKey",
          "label": "APIKey"
        }
      ]
    },
    {
      "id": "builtin-tencent",
      "label": "腾讯云实时语音识别",
      "script": "tencent.js",
      "hosts": [
        "asr.cloud.tencent.com"
      ],
      "config": [
        {
          "key": "appid",
          "label": "AppID"
        },
        {
          "key": "secretId",
          "label": "SecretId"
        },
        {
          "key": "secretKey",
          "label": "SecretKey",
          "secret": true
        },
        {
          "key": "engineModelType",
          "label": "引擎（如 16k_zh）"
        }
      ]
    },
    {
      "id": "builtin-volc",
      "label": "豆包流式语音识别（新版）",
      "script": "volc.js",
      "hosts": [
        "openspeech.bytedance.com"
      ],
      "config": [
        {
          "key": "apiKey",
          "label": "API Key",
          "secret": true
        },
        {
          "key": "resourceId",
          "label": "模型版本（选你开通的那个）",
          "type": "select",
          "options": [
            {
              "value": "volc.seedasr.sauc.duration",
              "label": "2.0 · 小时版（推荐）"
            },
            {
              "value": "volc.seedasr.sauc.concurrent",
              "label": "2.0 · 并发版"
            },
            {
              "value": "volc.bigasr.sauc.duration",
              "label": "1.0 · 小时版"
            },
            {
              "value": "volc.bigasr.sauc.concurrent",
              "label": "1.0 · 并发版"
            }
          ]
        },
        {
          "key": "enableNonstream",
          "label": "二次识别修正",
          "type": "switch"
        },
        {
          "key": "enableItn",
          "label": "规范为书面格式",
          "type": "switch"
        },
        {
          "key": "enableDdc",
          "label": "删除不流畅内容",
          "type": "switch"
        }
      ]
    },
    {
      "id": "builtin-volc-legacy",
      "label": "豆包流式语音识别（旧版）",
      "script": "volc-legacy.js",
      "hosts": [
        "openspeech.bytedance.com"
      ],
      "config": [
        {
          "key": "appId",
          "label": "App ID"
        },
        {
          "key": "accessToken",
          "label": "Access Token",
          "secret": true
        },
        {
          "key": "resourceId",
          "label": "模型版本（选你开通的那个）",
          "type": "select",
          "options": [
            {
              "value": "volc.seedasr.sauc.duration",
              "label": "2.0 · 小时版（推荐）"
            },
            {
              "value": "volc.seedasr.sauc.concurrent",
              "label": "2.0 · 并发版"
            },
            {
              "value": "volc.bigasr.sauc.duration",
              "label": "1.0 · 小时版"
            },
            {
              "value": "volc.bigasr.sauc.concurrent",
              "label": "1.0 · 并发版"
            }
          ]
        },
        {
          "key": "enableNonstream",
          "label": "二次识别修正",
          "type": "switch"
        },
        {
          "key": "enableItn",
          "label": "规范为书面格式",
          "type": "switch"
        },
        {
          "key": "enableDdc",
          "label": "删除不流畅内容",
          "type": "switch"
        }
      ]
    }
  ]
}
