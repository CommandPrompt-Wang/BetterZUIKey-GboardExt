<?xml version="1.0" encoding="utf-8"?>
<!--
    「自定义语音转文字」页 —— 结构逐字抄 BZK 的 activity_ime_adapter.xml
    （Toolbar + NestedScrollView：区块标题 → 列表 → ＋入口 → 分隔线 → 说明 → 分隔线 → 底部动作）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="自定义语音转文字" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- ═══ 选择配置文件 ═══ -->
            <TextView
                style="@style/ImeSectionHeader"
                android:text="选择配置文件" />

            <TextView
                style="@style/ImeNote"
                android:layout_marginTop="4dp"
                android:text="勾选以启用" />
            <TextView
                style="@style/ImeNote"
                android:text="单击以配置appid、apiKey等参数" />
            <TextView
                style="@style/ImeNote"
                android:text="长按卡片以复制其代码" />

            <LinearLayout
                android:id="@+id/list_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btn_add_profile"
                style="@style/ImeAddButton"
                android:text="＋ 添加配置文件" />

            <!-- ═══ 离线语音（与上面的配置文件互斥：同一时刻只有一个引擎生效）═══ -->
            <TextView
                style="@style/ImeSectionHeader"
                android:layout_marginTop="20dp"
                android:text="离线语音" />

            <TextView
                style="@style/ImeNote"
                android:layout_marginTop="4dp"
                android:text="使用SenseVoice模型，离线时亦可使用语音识别" />
            <TextView
                style="@style/ImeNote"
                android:text="需先下载模型才能勾选；与上方配置文件互斥" />
            <TextView
                style="@style/ImeNote"
                android:text="百分比是公开朗读测试集（AISHELL-1）的去标点字错误率，实际效果视口音/噪声而定" />

            <LinearLayout
                android:id="@+id/list_models"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/ImeNote"
                android:layout_marginTop="8dp"
                android:text="流式模型可能对口语的非流利现象较为敏感，可能出现转录效果下降的问题。" />
            <LinearLayout
                android:id="@+id/row_vad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启用切分"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="使用silero_vad切分句子，以增强非流式模型的实时效果。"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_vad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_punct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="补全标点"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="为不带标点的模型（Paraformer / 流式）插入标点"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_punct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp" />

            </LinearLayout>

            <!-- ═══ 说明 ═══ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- 这一块整体加个上边距：紧贴分割线会显得"顶住了"（用户口径） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <TextView
                    style="@style/ImeNote"
                    android:text="注意事项：" />

                <TextView
                    style="@style/ImeNote"
                    android:text="1. 未勾选任何配置文件将退回原版 STT" />
                <TextView
                    android:id="@+id/tv_note_issue"
                    style="@style/ImeNote"
                    android:text="2. 「测试」配置将在启动语音输入后输出「你好，世界。」供测试使用。如果没有正确输出，请提交 Issue，记得附上您的 Gboard 版本" />
                <TextView
                    style="@style/ImeNote"
                    android:text="3. 所有配置文件均可删除；如果意外删除/覆盖默认配置文件，可点击「恢复内置配置」还原" />
                <TextView
                    style="@style/ImeNote"
                    android:text="4. 长按配置文件卡片可复制代码，粘贴至别处编辑" />
                <TextView
                    style="@style/ImeNote"
                    android:text="5. 导入时以代码里的 engine.id 为唯一识别码，同名会覆盖已有配置" />

            </LinearLayout>

            <!-- ═══ 高级入口（恢复内置 / 强制更新） ═══ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/tv_restore_builtins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="恢复内置配置"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_force_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="强制更新配置文件"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
